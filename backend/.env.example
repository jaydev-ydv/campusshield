# CampusShield backend — environment template
#
#   cp backend/.env.example backend/.env
#
# .env is git-ignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Database — same cluster and driver as the migration layer
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://localhost:5432/campusshield

# Recreated on every test run. Must never point at a database holding real reports.
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/campusshield_backend_test

# ---------------------------------------------------------------------------
# Environment: development | testing | production
# ---------------------------------------------------------------------------
FLASK_ENV=development

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# dev      — trusts the X-Dev-User header WITHOUT VERIFICATION. Local only.
#            ProductionConfig refuses to start with this set.
# firebase — verifies Authorization: Bearer <Firebase ID token>. Use in
#            production, and locally whenever you need the real flow.
AUTH_PROVIDER=dev

# ---------------------------------------------------------------------------
# Firebase Authentication  (required when AUTH_PROVIDER=firebase)
# ---------------------------------------------------------------------------
# PLACEHOLDERS ONLY. Never commit real values, and never commit a service
# account file — .gitignore excludes *serviceAccount*.json and *firebase*.json,
# but the safest place for the file is outside the repository entirely.
#
# The project id is the audience an ID token is verified against. Without it
# tokens cannot be checked as belonging to this project, so startup fails rather
# than accepting anything.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Credentials — supply EXACTLY ONE of the three. Listed in preference order.
#
# 1. A service-account JSON file on disk. Best for local development.
#    Firebase console → Project settings → Service accounts → Generate new
#    private key. Store it outside the repo and chmod 600 it.
# FIREBASE_CREDENTIALS_PATH=/absolute/path/outside/repo/serviceAccountKey.json
#
# 2. The file's contents inline, for platforms that only offer env vars.
#    This value contains a private key: treat it exactly as you would one.
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
#
# 3. Neither — Application Default Credentials. Automatic on Google
#    infrastructure; elsewhere set GOOGLE_APPLICATION_CREDENTIALS to a file path.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/serviceAccountKey.json

# Check on every request whether the token has been revoked. Costs a network
# round trip per request; leave off unless an immediate sign-out must take effect
# faster than the one-hour token lifetime.
FIREBASE_CHECK_REVOKED=false

# ---------------------------------------------------------------------------
# Campus timezone
# ---------------------------------------------------------------------------
# Used to derive core.report.occurred_hour / occurred_dow, which feed hotspot
# detection and the night-hours risk factor. Getting this wrong skews every
# downstream pattern quietly rather than failing loudly.
CAMPUS_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Server-side secrets
# ---------------------------------------------------------------------------
# Optional in development, REQUIRED in production (startup fails without them).
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# AUDIT_IP_PEPPER keys the HMAC behind audit.access_log.ip_hash. Without it,
# client addresses are dropped rather than stored unkeyed — a bare SHA-256 of an
# IPv4 address is reversible by enumerating the whole space.
AUDIT_IP_PEPPER=
REPORT_TOKEN_PEPPER=

# ---------------------------------------------------------------------------
# Evidence storage  (image uploads)
# ---------------------------------------------------------------------------
# memory   — held in the Flask process. Lost on restart, and shared by nothing.
#            Local development and tests only; ProductionConfig refuses it.
# firebase — Firebase Cloud Storage, via the same Admin SDK credentials
#            configured above. Requires FIREBASE_STORAGE_BUCKET.
STORAGE_PROVIDER=memory

# The bucket name WITHOUT the gs:// prefix, e.g. your-project.appspot.com or
# your-project.firebasestorage.app. Firebase console → Storage → the name shown
# at the top of the Files tab.
#
# The bucket must stay PRIVATE. This application never returns a public URL and
# never makes an object publicly readable: image bytes are streamed back through
# an endpoint that checks authorisation on every request. A public bucket, or a
# rule allowing unauthenticated reads, defeats that entirely — anyone holding a
# path could read evidence attached to an anonymous report.
# FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app

# ---------------------------------------------------------------------------
# Machine assistance  (category suggestion, related reports, triage order)
# ---------------------------------------------------------------------------
# Path to an exported classification model, relative to the project root or
# absolute. Produce one with:
#
#   python scripts/export_baseline_model.py --register
#
# ABSENT IS A SUPPORTED STATE. Without it, reports are still accepted, still
# risk-scored, and still routed — they simply carry no category suggestion and
# no related-report proposals. The application logs the reason and starts.
#
# Every model this project can currently produce is trained on SYNTHETIC text:
# no licensable real-world corpus is available (see ml/DATASET.md). The artifact
# records that fact, the API returns it, and the responder interface states it.
# An artifact carrying no provenance is refused at load time.
MODEL_ARTIFACT_PATH=../ml/artifacts/tfidf-logreg-1.0.0.joblib

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
MAX_EVIDENCE_PER_REPORT=5

# Largest image accepted, in bytes. Enforced by the server on the received
# bytes; the browser is also told this number so it can reject early, but that
# check is a convenience and not the boundary. Default 10 MB.
MAX_IMAGE_UPLOAD_BYTES=10485760

# How long a staged upload survives before the reaper deletes it. An upload the
# student never attached to a report is not evidence, and must not linger.
PENDING_UPLOAD_TTL_HOURS=6

# ---------------------------------------------------------------------------
# Dev server
# ---------------------------------------------------------------------------
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
