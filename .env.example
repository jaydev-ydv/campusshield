# CampusShield — environment template
# Copy to .env and fill in.  .env is git-ignored; never commit real credentials.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Database connection
# ---------------------------------------------------------------------------
# Driver supports psycopg2 ("postgresql://") and psycopg 3 ("postgresql+psycopg://").
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
#
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/campusshield

# Local without password (e.g. Homebrew PostgreSQL where Unix user is DB superuser):
# DATABASE_URL=postgresql://localhost:5432/campusshield

# Local with an explicit application user (recommended, see DATABASE_SETUP.md §4):
# DATABASE_URL=postgresql://cs_app:CHANGE_ME@localhost:5432/campusshield

# Managed PostgreSQL (add TLS):
# DATABASE_URL=postgresql://user:pass@host:5432/campusshield?sslmode=require

# ---------------------------------------------------------------------------
# Test database — used by scripts/test_migration.sh, dropped and recreated
# on every run.  MUST NOT point at any database holding real reports.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/campusshield_migration_test

# ---------------------------------------------------------------------------
# Campus timezone
# ---------------------------------------------------------------------------
# core.report.occurred_hour / occurred_dow are plain columns computed by the
# application, not generated columns — EXTRACT(... FROM timestamptz) is not
# IMMUTABLE in PostgreSQL and cannot legally back one.  This is the zone the
# application must use when computing them.  See DATABASE.md §8.
CAMPUS_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Server-side secrets (NOT used by the migration layer; listed so the template
# is complete for the backend step).  Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
# AUDIT_IP_PEPPER=            # HMAC key for audit.access_log.ip_hash
# REPORT_TOKEN_PEPPER=        # anonymous report access tokens
